{
  "name": "3in",
  "version": "0.1.0",
  "private": true,
  "description": "3in: allenamenti, calendario e coach (PWA)",
  "scripts": {
    "test": "node --test tests/struttura.test.js tests/muscoli.test.js tests/avvio.test.js tests/cedimento.test.js",
    "test:browser": "for f in tests/browser/*.js; do echo \"== $f\"; node $f || exit 1; done",
    "sw": "node tools/genera-sw.js",
    "indice": "node tools/indice.js",
    "simboli": "node tools/simboli.js",
    "trova": "node tools/simboli.js --trova",
    "grafo": "node tools/simboli.js && node tools/grafo.js",
    "grafo:verifica": "node tools/grafo.js --verifica",
    "controlla": "npm run sw -- --check && npm run catalogo -- --check && npm run indice -- --check && npm run simboli -- --check && npm test",
    "catalogo": "node tools/genera-catalogo.js",
    "collaudo:schede": "node tools/collaudo-generatore.js"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "playwright-core": "^1.50.0"
  }
}
